<div id="bookmark_button_<%= sushi_item.id %>">
  <% bookmarked = bookmarked_ids.include?(sushi_item.id) %>
  <% if bookmarked %>
    <%= button_to sushi_item_bookmark_path(sushi_item), method: :delete, 
          data: { turbo_method: :delete, turbo_frame: "bookmark_button_#{sushi_item.id}" }, 
          class: 'text-warning btn btn-link p-0' do %>
      <i class="bi bi-star-fill"></i>
    <% end %>
  <% else %>
    <%= button_to sushi_item_bookmark_path(sushi_item), method: :post, 
          data: { turbo_frame: "bookmark_button_#{sushi_item.id}" }, 
          class: 'text-warning btn btn-link p-0' do %>
      <i class="bi bi-star"></i>
    <% end %>
  <% end %>
</div>
