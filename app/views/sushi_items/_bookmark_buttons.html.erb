<div id="bookmark_button_<%= sushi_item.id %>">
  <% bookmarked =
      if defined?(@bookmarked_ids) && @bookmarked_ids.present?
        @bookmarked_ids.include?(sushi_item.id)
      else
        current_user.bookmarks.exists?(sushi_item_id: sushi_item.id)
      end %>
  <% if bookmarked %>
    <%= button_to sushi_item_bookmark_path(sushi_item), method: :delete, data: { turbo_method: :delete, turbo_frame: "bookmark_button_#{sushi_item.id}" }, class: 'text-warning btn btn-link p-0' do %>
      <i class="bi bi-star-fill"></i>
    <% end %>
  <% else %>
    <%= button_to sushi_item_bookmark_path(sushi_item), method: :post, data: { turbo_frame: "bookmark_button_#{sushi_item.id}" }, class: 'text-warning btn btn-link p-0' do %>
      <i class="bi bi-star"></i>
    <% end %>
  <% end %>
</div>
