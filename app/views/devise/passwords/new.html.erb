
<div class="my-4 bg-white" style="max-width: 600px; margin-left: auto; margin-right: auto;">
  <div class="card shadow-sm">
    <div class="card-body">
      <h2 class="card-title text-center mb-4">パスワードの変更申請</h3>
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
  
        <div class="mt-3">
          <%= f.label :email, 'ご登録のメールアドレス', class: "form-label mb-1" %>
          <%= f.email_field :email, autofocus: true, class: "form-control" %>
        </div>
  
        <div class="d-grid mt-4">
          <%= f.submit t('devise.passwords.new.send_me_reset_password_instructions'), class: "btn btn-navy" %>
        </div>
      <% end %>

    </div>
  </div>
</div>
