<div class="my-4 bg-white" style="max-width: 600px; margin-left: auto; margin-right: auto;">
  <div class="card shadow-sm">
    <div class="card-body">

      <h2 class="card-title text-center mb-4">パスワード再設定</h2>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="mt-3">
          <%= f.label :新しいパスワード, class: "form-label mb-1" %>
          <% if @minimum_password_length %>
            <small class="text-muted">（<%= @minimum_password_length %>文字以上）</small>
          <% end %>
          <%= f.password_field :password, autofocus: true, class: "form-control" %>
        </div>

        <div class="field mt-3">
          <%= f.label :新しいパスワード（確認用）, class: "form-label mb-1" %>
          <%= f.password_field :password_confirmation, class: "form-control" %>
        </div>

        <div class="d-grid mb-4">
          <%= f.submit t('devise.passwords.edit.change_your_password'), class: "btn btn-navy" %>
        </div>
      <% end %>
    </div>
  </div>
</div>